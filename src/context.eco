/**
 * The terminal a program is talking to: what it can do, and where it writes.
 *
 * A context is that pair named once, the factory that mints widgets already
 * wired to it, and the writer those widgets share.
 *
 *   CLIContext $ctx = .resolve(.auto, .stderr);
 *   element::Text $name = $ctx->create<element::Text>('What is your name?');
 *
 * `create<T>` is a constructor call on T, with this context as the first
 * argument. Echo has no variadics, so arity is overloads. It is not a
 * registry: two creates are two objects.
 *
 * Widgets look up the live channel when they draw. Opening a run after minting
 * a widget, or closing one before asking, is what the widget will render.
 *
 *   $ctx->beginStepper('create-app');
 *   ...
 *   $ctx->endStepper('Done');
 *
 * Dropping a context still open closes the run. Call `endStepper` yourself
 * when the closing row should say something.
 */

namespace command;

public class CLIContext
{
    public TerminalCapabilities $caps;
    public std::io::stream $out;

    /**
     * False means the widgets this context mints capture instead of writing.
     * Tests reach for `buffer` / `plain` so they never touch the host tty.
     */
    public bool $toStream;
    public Block $page;
    /**
     * Raw VT from `write`. Live paint and CSI, never a finished row.
     */
    public string $vt;

    command::element::Run? $run;

    constructor(std::io::stream $out, TerminalCapabilities $caps)
    {
        $this->caps = $caps;
        $this->out = $out;
        $this->toStream = true;
        $this->page = Block();
        $this->vt = '';
        $this->run = null;
    }

    destructor()
    {
        $this->endStepper();
    }

    public static function resolve(ColorChoice $color, TerminalStream $stream) : CLIContext
    {
        return CLIContext(streamOf($stream), command::resolve($color, $stream));
    }

    /**
     * Honour `--color` the parse already took. Help on stdout and widgets on
     * stderr are two calls.
     */
    public static function from(
        const Parsed& $p,
        const Command& $app,
        TerminalStream $stream
    ) : CLIContext
    {
        return CLIContext(streamOf($stream), capabilitiesFor($p, $app, $stream));
    }

    public static function buffer(TerminalCapabilities $caps) : CLIContext
    {
        CLIContext $ctx = CLIContext(std::io::stderr, $caps);
        $ctx->toStream = false;

        return $ctx;
    }

    public static function plain() : CLIContext
    {
        return .buffer(command::plain());
    }

    public function create<T : class>() : T
    {
        return T($this);
    }

    public function create<T : class, A>(A $a) : T
    {
        return T($this, $a);
    }

    public function create<T : class, A, B>(A $a, B $b) : T
    {
        return T($this, $a, $b);
    }

    public function beginStepper(const string& $title) : void
    {
        if ($this->run != null) {
            die('command::CLIContext: stepper already open');
        }

        command::element::Run $run = command::element::Run($this);
        $this->run = $run;
        $this->line($run->stepper->open($title));
        $run->open = true;
    }

    public function endStepper() : void
    {
        $this->endStepper('');
    }

    public function endStepper(const string& $message) : void
    {
        command::element::Run $run = guard $this->run else {
            return;
        }

        if (!$run->open) {
            $this->run = null;
            return;
        }

        $run->open = false;
        $this->gap();
        $this->line($run->stepper->close($message));
        $this->run = null;
    }

    public const function channel() : command::element::Stepper
    {
        command::element::Run $run = guard $this->run else {
            return command::element::Stepper(false, $this->caps);
        }

        return $run->stepper;
    }

    public function gap() : void
    {
        string $bar = $this->channel()->spacer();

        if ($bar->empty()) {
            return;
        }

        $this->line($bar);
    }

    /**
     * A finished transcript row. The terminator is `writeline`'s, at the
     * stream; buffer mode records the row with none.
     */
    public function line(const string& $row) : void
    {
        if (!$this->toStream) {
            $this->page->push($row);
            return;
        }

        $this->out->writeline($row);
    }

    public function print(const Block& $block) : void
    {
        foreach ($block->rows as $row) {
            $this->line($row);
        }
    }

    /**
     * Raw VT into `$vt`. Live paint and CSI live here, never a finished row.
     */
    public function write(const string& $bytes) : void
    {
        if (!$this->toStream) {
            $this->vt->append($bytes);
            return;
        }

        $this->out->write($bytes);
    }

    public function printError(const string& $s) : void
    {
        if ($this->run != null) {
            command::SpinnerTheme $t = spinnerTheme($this->caps->unicode);
            $this->gap();
            $this->line($this->channel()->leadRow($t->outcome(false), outcomeSgr(false), $s));
            return;
        }

        string $badge = styled('error', SGR_ERROR, $this->caps->color);
        $this->line("{$badge}: {$s}");
    }
}

function streamOf(TerminalStream $stream) : std::io::stream
{
    if ($stream == TerminalStream::stdout) {
        return std::io::stdout;
    }

    return std::io::stderr;
}
