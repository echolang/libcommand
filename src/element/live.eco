/*
 * The one mutable trailing line. Carriage return and erase-to-end-of-line.
 */

namespace command::element;

/**
 * Where a live glyph row goes.
 *
 * `LiveLine` is the trailing line: carriage return and erase-to-end-of-line.
 * `LogStream` is a slot in a scrolling window. Progress and Spinner talk
 * to this, so docking is assigning `$line`.
 */
public interface LiveRow
{
    /**
     * True when paint rewrites instead of appending.
     */
    const function interactive() : bool;

    /**
     * Show `$text` as the current live row.
     */
    function paint(const string& $text) : void;

    /**
     * The work is done. `$ok` is how a window decides to keep its tail.
     */
    function settle(const string& $text, bool $ok) : void;

    /**
     * Take the live row off the screen.
     */
    function erase() : void;

    /**
     * A spacer before the first paint, when a run is open.
     */
    function gap() : void;
}

/**
 * The one trailing line a spinner or a bar rewrites.
 *
 * Paint is raw VT on a terminal, and silent on a pipe. A finished row
 * is a full line either way.
 */
public class LiveLine : LiveRow
{
    public command::CLIContext $ctx;

    constructor(command::CLIContext $ctx)
    {
        $this->ctx = $ctx;
    }

    /**
     * True when the stream is a terminal, so paint rewrites a line.
     */
    public const function interactive() : bool
    {
        return $this->ctx->caps->interactive;
    }

    /**
     * Columns a live line may use. Width 0 counts as 80.
     */
    public const function width() : int32
    {
        return command::liveWidth($this->ctx->caps);
    }

    /**
     * Rewrite the trailing line. Silent on a pipe.
     */
    public function paint(const string& $text) : void
    {
        if (!$this->ctx->caps->interactive) {
            return;
        }

        string $seq = command::CSI_ERASE_LINE;
        $seq->append($text);
        $this->ctx->write($seq);
    }

    /**
     * Finish the line. A terminal commits the VT. A pipe writes a full row.
     */
    public function commit(const string& $text) : void
    {
        if ($this->ctx->caps->interactive) {
            string $seq = command::CSI_ERASE_LINE;
            $seq->append($text);
            $seq->push(command::CH_LF);
            $this->ctx->write($seq);
            return;
        }

        $this->ctx->line($text);
    }

    /**
     * Erase the trailing line. Silent on a pipe.
     */
    public function erase() : void
    {
        if (!$this->ctx->caps->interactive) {
            return;
        }

        $this->ctx->write(command::CSI_ERASE_LINE);
    }

    /**
     * The work is done. On a LiveLine that is a commit, and `$ok` is
     * ignored. A LogStream collapses on success and keeps the tail on
     * failure, which is why the flag exists.
     */
    public function settle(const string& $text, bool $ok) : void
    {
        $this->commit($text);
    }

    /**
     * The context's gap: a channel spacer when a run is open.
     */
    public function gap() : void
    {
        $this->ctx->gap();
    }
}
