/*
 * A table of strings. The context it draws with is the one it was minted with.
 */

namespace command::element;

/**
 * One header cell.
 */
public struct Column
{
    public string $header;

    constructor(string $header)
    {
        $this->header = $header;
    }
}

#[docs::example: "examples/04-widgets.eco"]
/**
 * A table of strings.
 *
 * A class, because `create<T>` wants one, and the context it draws with
 * is the one it was minted with. `$showHeader` and `$border` are fields.
 * Both start on.
 *
 * ```echo
 * $t = $ctx->create<element::Table>();
 * $t->column('Feature');
 * $t->column('Status');
 * $t->row(['Help', 'ready']);
 * $t->display();
 * ```
 */
public class Table
{
    public command::CLIContext $ctx;
    public array<Column> $columns;
    public array<array<string>> $rows;
    public bool $showHeader;
    public bool $border;
    public command::Block $captured;

    constructor(command::CLIContext $ctx)
    {
        $this->ctx = $ctx;
        $this->columns = array<Column>();
        $this->rows = array<array<string>>();
        $this->showHeader = true;
        $this->border = true;
        $this->captured = command::Block();
    }

    /**
     * Add one column per header.
     */
    public function columns(const array<string>& $headers) : void
    {
        foreach ($headers as $header) {
            $this->column($header);
        }
    }

    /**
     * Add one column.
     */
    public function column(const string& $header) : void
    {
        $this->columns[] = Column($header);
    }

    /**
     * Append a row.
     *
     * A row longer than the columns dies. A short row leaves the rest empty.
     */
    public function row(array<string> $cells) : void
    {
        if ($cells->count() > $this->columns->count()) {
            die('command::element::Table: row longer than the header');
        }

        $this->rows[] = $cells;
    }

    /**
     * The table as rows, for composing.
     */
    public const function render() : command::Block
    {
        return renderTable($this, $this->ctx->caps);
    }

    /**
     * Write the table through the context it was minted with.
     */
    public function display() : void
    {
        $page = $this->render();
        writeOrCapture($this->ctx, $this->captured, $page);
    }
}

function renderTable(const Table& $t, const command::TerminalCapabilities& $caps) : command::Block
{
    if ($t->columns->empty()) {
        return command::Block();
    }

    array<int32> $widths = array<int32>();

    foreach ($t->columns as $col) {
        $widths[] = command::textWidth($col->header);
    }

    foreach ($t->rows as $row) {
        foreach ($row as $c => $cell) {
            int32 $w = command::textWidth($cell);

            if ($w > $widths[$c]) {
                $widths[$c] = $w;
            }
        }
    }

    command::BorderTheme $b = command::borderTheme($caps->unicode);
    $out = command::Block();

    if ($t->border) {
        writeRule($out, $b, $widths, $b->tl, $b->mt, $b->tr);
    }

    if ($t->showHeader) {
        writeCells($out, $t, $widths, $b, $caps, true, 0);
        if ($t->border) {
            writeRule($out, $b, $widths, $b->ml, $b->x, $b->mr);
        }
    }

    foreach ($t->rows as $r => $row) {
        writeCells($out, $t, $widths, $b, $caps, false, $r);
    }

    if ($t->border) {
        writeRule($out, $b, $widths, $b->bl, $b->mb, $b->br);
    }

    return $out;
}

function writeRule(
    command::Block& $out,
    const command::BorderTheme& $b,
    const array<int32>& $widths,
    const string& $left,
    const string& $mid,
    const string& $right
) : void
{
    string $row = $left;

    foreach ($widths as $c => $w) {
        $row->append(command::repeatCell($b->h, $w + 2));

        if ($c + 1 < $widths->count()) {
            $row->append($mid);
        }
    }

    $row->append($right);
    $out->push($row);
}

function writeCells(
    command::Block& $out,
    const Table& $t,
    const array<int32>& $widths,
    const command::BorderTheme& $b,
    const command::TerminalCapabilities& $caps,
    bool $header,
    usize $row
) : void
{
    string $line = '';

    if ($t->border) {
        $line->append($b->v);
    }

    foreach ($t->columns as $c => $col) {
        string $cell = '';

        if ($header) {
            $cell = command::styled($col->header, command::SGR_BOLD, $caps->color);
        }
        else if ($c < $t->rows[$row]->count()) {
            $cell = $t->rows[$row][$c];
        }

        int32 $pad = $widths[$c] - command::textWidth($cell);
        $line->append(' ');
        $line->append($cell);
        $line->append(command::spaces($pad));
        $line->append(' ');

        if ($t->border) {
            $line->append($b->v);
        }
    }

    $out->push($line);
}
