/**
 * Keyboard bytes a prompt can act on. Arrow keys arrive as CSI, not as
 * letters, so this is a small decoder rather than readline.
 *
 * Tests feed complete sequences. The live path reads stdin in raw mode.
 */

namespace command::element;

public enum Key
{
    case up;
    case down;
    case left;
    case right;
    case home;
    case end;
    case pageUp;
    case pageDown;
    case enter;
    case space;
    case tab;
    case backspace;
    case deleteForward;
    case killWord;
    case killLine;
    case escape;
    case eof;
    case text;
    case other;
}

/**
 * A key and the bytes it stood for.
 *
 * Key deliberately carries no payload. Echo builds `==` for a payload-free
 * enum and for nothing else, so a single `case text(string)` would take
 * `$key == Key::up` away from every prompt in this library and in yours. The
 * bytes ride alongside instead.
 *
 * Only `text` and `space` fill `$text`. Space fills it so an editor can insert
 * through one arm, while a Select still reads the case and toggles.
 */
public struct KeyEvent
{
    public Key $key;
    public string $text;

    constructor(Key $key)
    {
        $this->key = $key;
        $this->text = '';
    }

    constructor(Key $key, string $text)
    {
        $this->key = $key;
        $this->text = $text;
    }
}

class RawMode
{
    public bool $on;

    constructor()
    {
        $this->on = false;

        if (command::command_raw_enter() == 0) {
            $this->on = true;
        }
    }

    destructor()
    {
        $this->leave();
    }

    public function leave() : void
    {
        if (!$this->on) {
            return;
        }

        command::command_raw_leave();
        $this->on = false;
    }
}

public function decodeKey(const string& $bytes) : Key
{
    return decodeEvent($bytes)->key;
}

public function readKey() : Key
{
    return readEvent()->key;
}

public function decodeEvent(const string& $bytes) : KeyEvent
{
    if ($bytes->empty()) {
        return KeyEvent(Key::other);
    }

    int32 $first = $bytes->byte(0);

    if ($first != command::CH_ESC) {
        Key $named = keyFromControl($first);

        if ($named == Key::text) {
            return KeyEvent(Key::text, command::headScalar($bytes));
        }

        if ($named == Key::space) {
            return KeyEvent(Key::space, ' ');
        }

        return KeyEvent($named);
    }

    if ($bytes->size() == 1) {
        return KeyEvent(Key::escape);
    }

    int32 $second = $bytes->byte(1);

    if ($second == command::CH_LBRK) {
        return KeyEvent(decodeCsi($bytes));
    }

    if ($second == command::CH_O) {
        if ($bytes->size() < 3) {
            return KeyEvent(Key::other);
        }

        return KeyEvent(keyFromLetter($bytes->byte(2)));
    }

    return KeyEvent(Key::escape);
}

public function readEvent() : KeyEvent
{
    int32 $first = command::command_read_byte();

    if ($first < 0) {
        return KeyEvent(Key::eof);
    }

    return decodeEvent(readSequence($first));
}

/**
 * The bytes of one keystroke, gathered but not read.
 *
 * Reading and decoding are deliberately two jobs. A terminal delivers a
 * keystroke as one burst, so all this has to know is where the burst ends -
 * how many bytes a scalar takes, and which byte closes a CSI. What those bytes
 * mean is `decodeEvent`'s answer, and the tests that feed it complete
 * sequences are then testing the same code a terminal drives.
 */
function readSequence(int32 $first) : string
{
    uint8 $lead = $first;
    string $bytes = '';
    $bytes->push($lead);

    if ($first == command::CH_ESC) {
        readEscape($bytes);

        return $bytes;
    }

    if (keyFromControl($first) != Key::text) {
        return $bytes;
    }

    // the rest of a scalar whose lead byte we already hold. the wait never
    // fires on well-formed input; on a truncated paste it hands back what
    // arrived instead of blocking for bytes that are not coming
    usize $want = command::utf8Len($lead);

    while ($bytes->size() < $want) {
        int32 $b = command::command_read_byte_wait(1);

        if ($b < 0) {
            return $bytes;
        }

        uint8 $cont = $b;

        if (command::utf8Lead($cont)) {
            return $bytes;
        }

        $bytes->push($cont);
    }

    return $bytes;
}

/**
 * The rest of an escape sequence: a CSI up to its final byte, an SS3 and its
 * one letter, or nothing at all - a lone ESC is the Escape key.
 */
function readEscape(string& $bytes) : void
{
    int32 $second = command::command_read_byte_wait(1);

    if ($second < 0) {
        return;
    }

    uint8 $intro = $second;
    $bytes->push($intro);

    if ($second == command::CH_LBRK) {
        while (true) {
            int32 $b = command::command_read_byte_wait(1);

            if ($b < 0) {
                return;
            }

            uint8 $byte = $b;
            $bytes->push($byte);

            if (csiFinal($b)) {
                return;
            }
        }
    }

    if ($second != command::CH_O) {
        return;
    }

    int32 $third = command::command_read_byte_wait(1);

    if ($third < 0) {
        return;
    }

    uint8 $letter = $third;
    $bytes->push($letter);
}

/**
 * Whether this byte closes a CSI. Everything up to it is parameters - digits
 * and the separators between them - and the first byte that is neither is the
 * one that says what the sequence meant.
 */
function csiFinal(int32 $b) : bool
{
    if ($b >= command::CH_ZERO && $b <= command::CH_NINE) {
        return false;
    }

    return $b != command::CH_SEMI;
}

/**
 * A byte that is not a named key. Erase, kill and word-kill land here as
 * ordinary bytes because raw mode cleared ICANON; Ctrl-C never does, because
 * ISIG is still set and it is still a signal.
 */
function keyFromControl(int32 $b) : Key
{
    if ($b == command::CH_LF || $b == command::CH_CR) {
        return .enter;
    }

    if ($b == command::CH_SPACE) {
        return .space;
    }

    if ($b == command::CH_TAB) {
        return .tab;
    }

    if ($b == command::CH_DEL || $b == command::CH_BS) {
        return .backspace;
    }

    if ($b == command::CH_CTRL_U) {
        return .killLine;
    }

    if ($b == command::CH_CTRL_W) {
        return .killWord;
    }

    if ($b == command::CH_CTRL_A) {
        return .home;
    }

    if ($b == command::CH_CTRL_E) {
        return .end;
    }

    if ($b < command::CH_SPACE) {
        return .other;
    }

    return .text;
}

function decodeCsi(const string& $bytes) : Key
{
    if ($bytes->size() < 3) {
        return .other;
    }

    int32 $last = $bytes->byte($bytes->size() - 1);
    Key $letter = keyFromLetter($last);

    if ($letter != Key::other) {
        return $letter;
    }

    if ($last != command::CH_TILDE) {
        return .other;
    }

    return keyFromTilde(csiParam($bytes));
}

/**
 * The leading numeric parameter of a CSI, or 0 where there was none - which
 * `keyFromTilde` has no case for, so an absent parameter and an unknown one
 * come back as the same unknown key.
 */
function csiParam(const string& $bytes) : int32
{
    int32 $n = 0;
    usize $i = 2;

    while ($i + 1 < $bytes->size()) {
        int32 $b = $bytes->byte($i);

        if ($b < command::CH_ZERO || $b > command::CH_NINE) {
            break;
        }

        $n = $n * 10 + ($b - command::CH_ZERO);
        $i = $i + 1;
    }

    return $n;
}

function keyFromLetter(int32 $b) : Key
{
    if ($b == command::CH_A) {
        return .up;
    }

    if ($b == command::CH_B) {
        return .down;
    }

    if ($b == command::CH_C) {
        return .right;
    }

    if ($b == command::CH_D) {
        return .left;
    }

    if ($b == command::CH_H) {
        return .home;
    }

    if ($b == command::CH_F) {
        return .end;
    }

    return .other;
}

function keyFromTilde(int32 $n) : Key
{
    if ($n == 1) {
        return .home;
    }

    if ($n == 3) {
        return .deleteForward;
    }

    if ($n == 4) {
        return .end;
    }

    if ($n == 5) {
        return .pageUp;
    }

    if ($n == 6) {
        return .pageDown;
    }

    return .other;
}

function stdinIsTty() : bool
{
    return std::io::stdin->isatty();
}
