/*
 * A spinner that keeps moving while this thread is busy.
 */

namespace command::element;

use std::thread;

#[atomic]
#[docs::example: "examples/05-live.eco"]
/**
 * A spinner that keeps moving while this thread is busy.
 *
 * The work stays here. The animation is the other thread. `succeed`,
 * `fail` and `stop` join that thread before they write the last line.
 * On a pipe, paint is silent and the finished call writes a full line.
 *
 * ```echo
 * $s = $ctx->create<element::Spinner>();
 * $s->start('fetching');
 * $s->update('unpacking');
 * $s->succeed('vendored 4 packages');
 * ```
 */
public class Spinner : LiveTicks
{
    public LiveRow $line;
    public Ticker $ticker;
    public string $text;
    public int32 $frame;
    public command::CLIContext $ctx;

    /** Resolved once: the tick runs 12.5x a second and only ever indexes it. */
    public command::SpinnerTheme $spin;

    constructor(command::CLIContext $ctx)
    {
        $this->line = LiveLine($ctx);
        $this->ticker = Ticker();
        $this->text = '';
        $this->frame = 0;
        $this->ctx = $ctx;
        $this->spin = command::spinnerTheme($ctx->caps->unicode);
    }

    destructor()
    {
        $this->stop();
    }

    /**
     * The channel this spinner draws on. A live run puts the glyph in the bar.
     */
    public const function channel() : Stepper
    {
        return $this->ctx->channel();
    }

    /**
     * Paint the first frame and start the tick. On a pipe, arm it and wait.
     */
    public function start(string $message) : void
    {
        if ($this->ticker->running->load()) {
            die('command::element::Spinner: already running');
        }

        $this->line->gap();
        $this->setText($message);
        $this->frame = 0;

        if (!$this->line->interactive()) {
            $this->ticker->arm('command::element::Spinner');
            return;
        }

        $this->line->paint($this->lockedRow($message));
        $this->ticker->start('command::element::Spinner', $this);
    }

    /**
     * Change the words. The glyph keeps cycling.
     */
    public function update(string $message) : void
    {
        $this->setText($message);
    }

    /**
     * Join the tick and write one finished row.
     */
    public function succeed(string $message) : void
    {
        $this->ticker->halt();
        $this->line->settle($this->finalRow(true, $message), true);
    }

    /**
     * Join the tick and write the row as a failure.
     */
    public function fail(string $message) : void
    {
        $this->ticker->halt();
        $this->line->settle($this->finalRow(false, $message), false);
    }

    /**
     * Join the tick and erase the line.
     */
    public function stop() : void
    {
        $this->ticker->halt();
        $this->line->erase();
    }

    /**
     * Pause the tick and erase the line, so something else can use the stream.
     */
    public function suspend() : void
    {
        $this->ticker->pause();
        $this->line->erase();
    }

    function tickOnce() : void
    {
        string? $row = $this->takeRow();
        string $text = guard $row else {
            return;
        }

        $this->line->paint($text);
    }

    function takeRow() : string?
    {
        thread::locked<int32> $g = $this->ticker->gate->lock();

        if (!$this->ticker->running->load() || $this->ticker->paused->load()) {
            return null;
        }

        string $row = $this->spinRow($this->text);
        $this->frame = $this->frame + 1;

        return $row;
    }

    function lockedRow(string $message) : string
    {
        thread::locked<int32> $g = $this->ticker->gate->lock();

        return $this->spinRow($message);
    }

    const function spinRow(const string& $message) : string
    {
        return $this->channel()->glyphRow(
            $this->spin->frameAt($this->frame),
            command::SGR_INFO,
            $message
        );
    }

    const function finalRow(bool $ok, const string& $message) : string
    {
        return $this->channel()->glyphRow(
            $this->spin->outcome($ok),
            command::outcomeSgr($ok),
            $message
        );
    }

    function setText(string $message) : void
    {
        thread::locked<int32> $g = $this->ticker->gate->lock();
        $this->text = $message;
    }
}

/**
 * Run `$work` under a spinner labelled `$message`, and return what it returns.
 *
 * The finished row uses the same label. There is no other overload: the
 * spinner is minted from `$ctx`, so a live session still joins the bar.
 */
public function spin<T>(
    command::CLIContext $ctx,
    string $message,
    function<T()> $work
) : T
{
    Spinner $s = Spinner($ctx);
    $s->start($message);
    T $v = $work();
    $s->succeed($message);

    return $v;
}
