/*
 * A tree of labels. You build the children arrays, then render.
 */

namespace command::element;

/**
 * One label, and the nodes under it.
 *
 * Push into `$children` directly.
 */
public struct Node
{
    public string $label;
    public array<Node> $children;

    constructor(string $label)
    {
        $this->label = $label;
        $this->children = array<Node>();
    }
}

#[docs::example: "examples/04-widgets.eco"]
/**
 * A tree of labels.
 *
 * The constructor argument is the root label. Build the rest by pushing
 * into `$node->children`.
 *
 * ```echo
 * $tree = $ctx->create<element::Tree>('root');
 * element::Node $src = element::Node('src');
 * $src->children[] = element::Node('main.eco');
 * $tree->root->children[] = $src;
 * $tree->display();
 * ```
 */
public class Tree
{
    public command::CLIContext $ctx;
    public Node $root;
    public command::Block $captured;

    constructor(command::CLIContext $ctx, string $label)
    {
        $this->ctx = $ctx;
        $this->root = Node($label);
        $this->captured = command::Block();
    }

    /**
     * The tree as rows, for composing.
     */
    public const function render() : command::Block
    {
        $out = command::Block();
        $out->push($this->root->label);
        writeChildren($out, $this->root->children, '', $this->ctx->caps);

        return $out;
    }

    /**
     * Write the tree through the context it was minted with.
     */
    public function display() : void
    {
        $page = $this->render();
        writeOrCapture($this->ctx, $this->captured, $page);
    }
}

function writeChildren(
    command::Block& $out,
    const array<Node>& $kids,
    const string& $prefix,
    const command::TerminalCapabilities& $caps
) : void
{
    command::TreeTheme $theme = command::treeTheme($caps->unicode);
    usize $n = $kids->count();

    foreach ($kids as $i => $kid) {
        bool $last = $i + 1 == $n;
        string $next = $theme->pipe;
        string $branch = $theme->branch;

        if ($last) {
            $next = $theme->blank;
            $branch = $theme->last;
        }

        string $row = $prefix;
        $row->append($branch);
        $row->append($kid->label);
        $out->push($row);
        writeChildren($out, $kid->children, "{$prefix}{$next}", $caps);
    }
}
