/*
 * A live block of more than one row. Cursor-up, then erase-down.
 */

namespace command::element;

/**
 * A live block of more than one row.
 *
 * A selection menu and a log window are painted here. The previous height
 * is how far to climb before the next paint. The terminal cursor stays
 * hidden while a frame is on screen, because the widget paints its own
 * caret into the frame. It comes back on commit, on erase, and if this
 * region is dropped still hidden.
 */
public class LiveRegion
{
    public command::CLIContext $ctx;
    public int32 $height;
    public bool $hidden;

    constructor(command::CLIContext $ctx)
    {
        $this->ctx = $ctx;
        $this->height = 0;
        $this->hidden = false;
    }

    destructor()
    {
        if ($this->hidden) {
            $this->erase();
        }
    }

    /**
     * True when the stream is a terminal.
     */
    public const function interactive() : bool
    {
        return $this->ctx->caps->interactive;
    }

    /**
     * Whether a prompt drawn here can run live: something has to be able to
     * read the frame, and something has to be able to type at it.
     */
    public const function drivable() : bool
    {
        return $this->ctx->caps->interactive && stdinIsTty();
    }

    /**
     * Rewrite the block. The cursor climbs by the previous height first.
     */
    public function paint(const command::Block& $block) : void
    {
        int32 $n = command::i32Of($block->rows->count());

        if (!$this->ctx->caps->interactive) {
            $this->height = $n;
            return;
        }

        string $seq = $this->hide();
        $seq->append($this->rewind());

        foreach ($block->rows as $i => $row) {
            if ($i > 0) {
                $seq->push(command::CH_LF);
            }

            $seq->append($row);
        }

        $this->ctx->write($seq);
        $this->height = $n;
    }

    /**
     * Paint `$block` and leave it as finished rows. The cursor comes back.
     */
    public function commit(const command::Block& $block) : void
    {
        if ($this->ctx->caps->interactive) {
            $this->paint($block);
            string $tail = '';
            $tail->push(command::CH_LF);
            $tail->append($this->show());
            $this->ctx->write($tail);
            $this->height = 0;
            return;
        }

        $this->ctx->print($block);
        $this->height = 0;
    }

    /**
     * Take the block off the screen and show the cursor.
     */
    public function erase() : void
    {
        if (!$this->ctx->caps->interactive) {
            $this->height = 0;
            $this->hidden = false;
            return;
        }

        string $seq = $this->rewind();
        $seq->append($this->show());

        if ($seq->empty()) {
            return;
        }

        $this->ctx->write($seq);
        $this->height = 0;
    }

    /**
     * The climb back to the top of the block on screen, and the erase of it.
     */
    const function rewind() : string
    {
        if ($this->height <= 0) {
            return '';
        }

        string $seq = command::cursorUp($this->height - 1);
        $seq->append(command::CSI_ERASE_DOWN);

        return $seq;
    }

    /**
     * The bytes that take the terminal's cursor away, once. The shim is told
     * as well, so a Ctrl-C out of a live prompt does not leave a terminal
     * without a cursor. ISIG stays set in raw mode, so that is a real exit.
     */
    function hide() : string
    {
        if ($this->hidden || !$this->ctx->caps->interactive) {
            return '';
        }

        $this->hidden = true;

        if ($this->ctx->toStream) {
            command::command_cursor_hidden(1);
        }

        return command::CURSOR_HIDE;
    }

    function show() : string
    {
        if (!$this->hidden) {
            return '';
        }

        $this->hidden = false;

        if ($this->ctx->toStream) {
            command::command_cursor_hidden(0);
        }

        return command::CURSOR_SHOW;
    }
}
