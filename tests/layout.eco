/**
 * Wrapping, headings, SGR strip, tree branches. Forced capabilities, never the host.
 */

use command;

test strip_sgr_removes_escapes
{
    string $raw = command::styled('build', command::SGR_INFO, true);

    assert(command::stripSgr($raw) == 'build', 'SGR gone');
    assert(command::textWidth($raw) == 5, 'columns, not bytes');
}

test fit_head_leaves_a_string_that_fits
{
    assert(command::fitHead('build', 10, '…') == 'build', 'untouched');
    assert(command::fitHead('build', 5, '…') == 'build', 'exactly');
}

test fit_head_keeps_the_front
{
    assert(command::fitHead('abcdefgh', 5, '…') == 'abcd…', 'head, not tail');
    assert(command::textWidth(command::fitHead('abcdefgh', 5, '…')) == 5, 'to the column');
}

test fit_head_keeps_colour_through_the_cut
{
    string $raw = command::styled('abcdefgh', command::SGR_INFO, true);
    string $got = command::fitHead($raw, 5, '…');

    assert($got->starts(command::SGR_INFO), 'opening sequence survives');
    // a cut lands mid-span and cannot know what was open, so this one place
    // closes with the full reset rather than a targeted off
    assert($got->contains(command::SGR_RESET), 'closing sequence survives');
    assert(command::stripSgr($got) == 'abcd…', 'four columns and the ellipsis');
    assert(command::textWidth($got) == 5, 'escapes cost no columns');
}

test fit_head_refuses_a_width_the_ellipsis_cannot_share
{
    assert(command::fitHead('abcdefgh', 1, '…') == '…', 'only the ellipsis');
    assert(command::fitHead('abcdefgh', 0, '…') == '', 'nothing at all');
}

test fit_head_counts_scalars_not_bytes
{
    assert(command::fitHead('ä├ö┤ü', 3, '…') == 'ä├…', 'two scalars and the ellipsis');
}

test utf8_len_measures_a_scalar
{
    assert(command::utf8Len(97) == 1, 'ascii');
    assert(command::utf8Len(195) == 2, 'two-byte lead');
    assert(command::utf8Len(226) == 3, 'three-byte lead');
    assert(command::utf8Len(240) == 4, 'four-byte lead');
    assert(command::utf8Len(164) == 1, 'a continuation byte is one opaque unit');
}

test page_width_zero_is_eighty
{
    assert(command::pageWidth(command::plain()) == 80, 'unknown is 80');
}

test page_width_caps_at_a_hundred
{
    command::TerminalCapabilities $wide = command::TerminalCapabilities(false, false, 200, true);

    assert(command::pageWidth($wide) == 100, 'a 200-column terminal is still 100');
}

test page_width_keeps_a_real_window
{
    command::TerminalCapabilities $c = command::TerminalCapabilities(false, false, 72, true);

    assert(command::pageWidth($c) == 72, '72 stays 72');
}

test live_width_zero_is_eighty_and_does_not_cap
{
    command::TerminalCapabilities $wide = command::TerminalCapabilities(false, false, 200, true);

    assert(command::liveWidth(command::plain()) == 80, 'unknown is 80');
    assert(command::liveWidth($wide) == 200, 'progress uses the real width');
}

test heading_ascii_is_the_words
{
    command::TerminalCapabilities $c = command::plain();
    $out = command::Block();
    command::writeHeading($out, 'Usage', $c);

    assert($out->rows->count() == 1, 'one row');
    assert(command::stripSgr($out->rows[0]) == 'Usage', 'no bar, no rule');
}

test heading_unicode_has_a_bar
{
    command::TerminalCapabilities $c = command::TerminalCapabilities(false, true, 40, true);
    $out = command::Block();
    command::writeHeading($out, 'Usage', $c);
    string $plain = command::stripSgr($out->rows[0]);

    assert($plain->starts('▌ Usage'), 'left bar');
    assert($plain->contains('─'), 'dim rule');
}

test tree_branch_ascii_last_is_backtick
{
    assert(command::treeBranch(false, false) == '|- ', 'mid');
    assert(command::treeBranch(true, false) == '`- ', 'last');
}

test tree_branch_unicode
{
    assert(command::treeBranch(false, true) == '├─ ', 'mid');
    assert(command::treeBranch(true, true) == '└─ ', 'last');
}

test wrap_keeps_a_short_line
{
    command::TerminalCapabilities $c = command::plain();
    $out = command::Block();
    command::writeWrapped($out, 'hello', 0, $c);

    assert($out->rows->count() == 1, 'one line');
    assert($out->rows[0] == 'hello', 'the words');
}

test wrap_breaks_on_spaces
{
    command::TerminalCapabilities $c = command::TerminalCapabilities(false, false, 20, true);
    $out = command::Block();
    command::writeWrapped($out, 'one two three four five six', 0, $c);

    assert($out->rows->count() > 1, 'wrapped');
}

test wrap_array_is_the_same_picture_as_the_joined_string
{
    command::TerminalCapabilities $c = command::plain();
    array<string> $lines = [
        'Print a page.',
        '  greet --help',
        '  greet build --help',
        'The last form.',
    ];
    $fromString = command::Block();
    $fromArray = command::Block();
    command::writeWrapped($fromString, str::join($lines, "\n"), 0, $c);
    command::writeWrapped($fromArray, $lines, 0, $c);

    assert($fromString == $fromArray, 'the array is the stored form, not a join');
}

test text_width_counts_columns_not_bytes
{
    assert(command::textWidth('├─ ') == 3, 'box drawing is one column each');
    assert(command::textWidth('▌') == 1, 'bar is one column');

    string $raw = command::styled('├─ ', command::SGR_DIM, true);
    assert(command::textWidth($raw) == 3, 'SGR does not add columns');
}
