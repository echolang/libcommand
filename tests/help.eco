/**
 * Help structure. Wording is not pinned; presence, columns, and width are.
 */

use command;

function parsedHelp(const command::Command& $app, const array<string>& $rest) : command::Parsed
{
    command::Outcome $r = $app->parse(argv($rest));
    assert($r->error == null, 'parse ok');
    assert($r->parsed->wantsHelp, 'asked for help');

    return $r->parsed;
}

function noLineTooWide(const command::Block& $page, int32 $width) : bool
{
    foreach ($page->rows as $row) {
        if (command::textWidth(command::stripSgr($row)) > $width) {
            return false;
        }
    }

    return true;
}

test version_is_the_number
{
    command::Command $app = greet();

    assert(command::renderVersion($app) == '0.1.0', 'version only');
}

test root_help_lists_commands_and_builtins
{
    command::Command $app = greet();
    command::Parsed $p = parsedHelp($app, words1('--help'));
    $page = command::renderHelp($app, $p, command::plain());

    assert(blockHas($page, 'Usage'), 'usage');
    assert(blockHas($page, 'Commands'), 'commands');
    assert(blockHas($page, 'build'), 'build');
    assert(blockHas($page, '--help'), 'help');
    assert(blockHas($page, '--version'), 'version');
    assert(blockHas($page, '--color'), 'color');
    assert(!blockHas($page, '--output'), 'build flags stay off the root page');
    assert(noLineTooWide($page, 80), 'width');
}

test build_help_lists_accepted_options
{
    command::Command $app = greet();
    command::Parsed $p = parsedHelp($app, words2('build', '--help'));
    $page = command::renderHelp($app, $p, command::plain());

    assert(blockHas($page, '--output'), 'output');
    assert(blockHas($page, '--optimize'), 'optimize');
    assert(blockHas($page, '|- none'), 'ascii tree');
    assert(blockHas($page, 'module'), 'module value');
    assert(blockHas($page, '(default)'), 'fallback marker');
    assert(blockHas($page, 'How it is built'), 'category');
    assert(blockHas($page, 'What is built'), 'inputs');
    assert(noLineTooWide($page, 80), 'width');
}

test option_page_is_the_prose
{
    command::Command $app = greet();
    command::Parsed $p = parsedHelp($app, words3('build', '--help', 'optimize'));
    $page = command::renderHelp($app, $p, command::plain());

    assert(blockHas($page, '--optimize'), 'heading');
    assert(blockHas($page, 'none'), 'value');
    assert(blockHas($page, 'Accepted by'), 'who');
    assert(blockHas($page, "Defaults to 'module'"), 'fallback');
}

test unicode_help_uses_box_trees
{
    command::Command $app = greet();
    command::Parsed $p = parsedHelp($app, words2('build', '--help'));
    command::TerminalCapabilities $caps = command::TerminalCapabilities(false, true, 80, true);
    $page = command::renderHelp($app, $p, $caps);

    assert(blockHas($page, '▌'), 'bar');
    assert(blockHas($page, '├─'), 'branch');
    assert(blockHas($page, '└─'), 'last');
}

test error_page_has_usage
{
    command::Command $app = greet();
    command::Outcome $r = $app->parse(words1('greet'));
    command::Error $e = $r->error ?? .noCommand;
    $page = command::renderError($e, $app, $r->parsed, command::plain());

    assert($page->rows[0]->contains('error:'), 'badge');
    assert(blockHas($page, 'Usage'), 'usage');
    assert(blockHas($page, '--help'), 'pointer');
}

test positional_category_is_the_one_you_named
{
    command::Command $app = command::Command('greet', '0.1.0', 'say hello');
    command::Subcommand $build = $app->command('build', 'compile', 'Compile it.');
    $app->positional($build, '<sources...>', 'the files', 'The sources.', 0, -1, 'Sources');
    command::Arg $out = $app->arg('output', 'o', '<file>', 'where it goes');
    $app->category($out, 'What is built');
    $app->accept($out, $build);

    command::Parsed $p = parsedHelp($app, words2('build', '--help'));
    $page = command::renderHelp($app, $p, command::plain());

    assert(blockHas($page, 'Sources'), 'named category');
    assert(blockHas($page, '<sources...>'), 'the metavar');
    assert(blockHas($page, 'What is built'), 'option category is separate');
    assert(!blockHas($page, 'The sources.'), 'the long description is not a second copy');
}

test root_help_shows_a_positional
{
    command::Command $app = command::Command('grep', '0.1.0', 'search');
    $app->positional('<pattern>', 'the pattern', 'A regular expression.', 1, 1, 'Input');

    command::Parsed $p = parsedHelp($app, words1('--help'));
    $page = command::renderHelp($app, $p, command::plain());

    assert(blockHas($page, '<pattern>'), 'metavar');
    assert(blockHas($page, 'Input'), 'category');
    assert(blockHas($page, '[options] <pattern>'), 'usage');
}
