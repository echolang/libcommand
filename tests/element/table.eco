/**
 * Table rendering.
 */

use command::element;

test table_ascii_has_header_and_row
{
    element::Table $t = command::CLIContext::plain()->create<element::Table>();
    $t->column('Feature');
    $t->column('Status');
    array<string> $r = array<string>();
    $r[] = 'Markup';
    $r[] = 'ready';
    $t->row($r);

    $page = $t->render();

    assert(blockHas($page, 'Feature'), 'header');
    assert(blockHas($page, 'Status'), 'header 2');
    assert(blockHas($page, 'Markup'), 'cell');
    assert(blockHas($page, 'ready'), 'cell 2');
    assert(blockHas($page, '+'), 'ascii corner');
    assert(blockHas($page, '|'), 'ascii bar');
}

test table_unicode_uses_box
{
    command::CLIContext $ctx = .buffer(
        command::TerminalCapabilities(false, true, 80, true)
    );
    element::Table $t = $ctx->create<element::Table>();
    $t->column('A');
    array<string> $r = array<string>();
    $r[] = 'x';
    $t->row($r);

    $page = $t->render();

    assert(blockHas($page, '┌'), 'tl');
    assert(blockHas($page, '│'), 'v');
}

test table_display_captures
{
    command::CLIContext $ctx = .plain();
    element::Table $t = $ctx->create<element::Table>();
    $t->column('Feature');
    $t->column('Status');
    $t->row(['Markup', 'ready']);
    $t->display();

    $page = $t->render();
    assert($t->captured == $page, 'captured matches render');
    assert($ctx->vt->empty(), 'buffer capture is on the widget');
    assert($ctx->page->rows->count() == 0, 'buffer capture is on the widget');

    $t->display();
    assert($t->captured->rows->count() == $page->rows->count() * 2, 'second display appends');
}
