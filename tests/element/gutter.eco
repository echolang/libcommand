/**
 * A run: opening, closing, marks, and the note box.
 */

use command;
use command::element;

function plainCtx() : command::CLIContext
{
    return .buffer(command::TerminalCapabilities(false, true, 60, true));
}

test stepper_opens_with_a_corner
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('create-app');

    assert($ctx->page->rows->count() == 1, 'the run starts');
    assert($ctx->page->rows[0] == '┌  create-app', 'the run starts');
}

test stepper_closes_with_a_bar_then_a_corner
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('create-app');
    $ctx->page = command::Block();
    $ctx->endStepper('Done');

    assert($ctx->page->rows->count() == 2, 'a bar, then the end');
    assert($ctx->page->rows[0] == '│', 'a bar, then the end');
    assert($ctx->page->rows[1] == '└  Done', 'a bar, then the end');
}

test stepper_closes_clean_with_no_message
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('x');
    $ctx->page = command::Block();
    $ctx->endStepper();

    assert($ctx->page->rows->count() == 2, 'no row of trailing spaces');
    assert($ctx->page->rows[0] == '│', 'no row of trailing spaces');
    assert($ctx->page->rows[1] == '└', 'no row of trailing spaces');
}

test stepper_end_only_fires_once
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('x');
    $ctx->endStepper('a');
    $ctx->page = command::Block();
    $ctx->endStepper('b');

    assert($ctx->page->rows->count() == 0, 'a closed run stays closed');
}

test stepper_marks_carry_their_own_symbol
{
    element::Stepper $ch = element::Stepper(true, command::TerminalCapabilities(false, true, 60, true));
    command::SpinnerTheme $spin = command::spinnerTheme(true);

    assert($ch->leadRow($ch->theme->markInfo, command::SGR_INFO, 'one') == '●  one', 'info');
    assert($ch->leadRow($ch->theme->stepError, command::SGR_WARNING, 'two') == '▲  two', 'warn');
    assert($ch->leadRow($spin->outcome(false), command::outcomeSgr(false), 'three') == '■  three', 'error');
    assert($ch->leadRow($spin->outcome(true), command::outcomeSgr(true), 'four') == '✔  four', 'success');
}

test stepper_marks_leave_a_bar_above_themselves
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('x');
    $ctx->page = command::Block();
    $ctx->printError('one');

    assert($ctx->page->rows->count() == 2, 'a gap, then the mark');
    assert($ctx->page->rows[0] == '│', 'a gap, then the mark');
    assert($ctx->page->rows[1] == '■  one', 'a gap, then the mark');
}

test stepper_note_box_closes_on_every_row
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('x');
    $ctx->page = command::Block();
    $ctx->gap();
    array<string> $body = ['line one', 'line two'];
    $ctx->print(element::noteFrame($ctx->channel(), 'Heads up', $body));

    array<string> $rows = $ctx->page->rows;

    // the gap, then the box: title, blank, two body rows, blank, foot
    assert($rows->count() == 7, 'the gap and the six box rows');
    assert($rows[1]->starts('◇  Heads up ─'), 'the title opens the rule');
    assert($rows[1]->ends('╮'), 'and turns the corner');
    assert($rows[6]->starts('├─'), 'the foot joins the bar');
    assert($rows[6]->ends('╯'), 'and closes the box');

    // every row of the box is exactly as wide as its top
    int32 $w = command::textWidth($rows[1]);
    assert(command::textWidth($rows[2]) == $w, 'blank row');
    assert(command::textWidth($rows[3]) == $w, 'first body row');
    assert(command::textWidth($rows[4]) == $w, 'second body row');
    assert(command::textWidth($rows[6]) == $w, 'foot');
}

test stepper_note_degrades_without_a_box_off_run
{
    element::Stepper $off = element::Stepper(false, command::TerminalCapabilities(false, true, 60, true));
    $got = element::noteFrame($off, 'Heads up', "line one\nline two");

    assert($got->rows->count() == 3, 'a title and an indented body');
    assert($got->rows[0] == '  Heads up', 'a title and an indented body');
    assert($got->rows[1] == '  line one', 'a title and an indented body');
    assert($got->rows[2] == '  line two', 'a newline in the string is a row');
    assert(!blockHas($got, '╮'), 'nothing to hang a box from');
}

test stepper_note_stays_inside_the_terminal
{
    command::CLIContext $ctx = .buffer(
        command::TerminalCapabilities(false, true, 24, true)
    );
    $ctx->beginStepper('x');
    $ctx->page = command::Block();
    $ctx->gap();
    $ctx->print(element::noteFrame($ctx->channel(), 'a', 'a very long line that will not fit inside twenty-four columns'));

    foreach ($ctx->page->rows as $row) {
        assert(command::textWidth($row) < 24, 'no row may reach the edge');
    }
}

test print_error_off_run_is_the_badge
{
    command::CLIContext $ctx = plainCtx();
    $ctx->printError('Aborted!');

    assert($ctx->page->rows->count() == 1, 'the refusal badge');
    assert($ctx->page->rows[0]->contains('error: Aborted!'), 'the refusal badge');
    assert(!$ctx->page->rows[0]->contains('■'), 'not a channel mark');
}

#[tests: expects death]
test begin_stepper_twice_dies
{
    command::CLIContext $ctx = plainCtx();
    $ctx->beginStepper('a');
    $ctx->beginStepper('b');
}


