/**
 * Cooperative bar. Spectre-shaped: glyph, two-tone track, padded percent.
 */

use command::element;
use std::thread;

test progress_noninteractive_ticks_are_silent
{
    element::Progress $p = command::CLIContext::plain()->create<element::Progress>();
    $p->start('download', 10);
    $p->advance(1, 'a.eco');
    $p->finish();

    assert($p->line->ctx->vt == '', 'no CR');
    $got = $p->line->ctx->page;
    assert(blockHas($got, '*'), 'done glyph');
    assert(blockHas($got, 'download'), 'label');
    assert(blockHas($got, '----------------------------------------'), 'full fill');
    assert(blockHas($got, '100%'), 'full percent');
    assert($p->line->ctx->page->rows->count() == 1, 'a line');
}

test progress_fail_keeps_the_fraction
{
    element::Progress $p = command::CLIContext::plain()->create<element::Progress>();
    $p->start('download', 10);
    $p->set(5, 'a.eco');
    $p->fail();

    $got = $p->line->ctx->page;
    assert(blockHas($got, 'x'), 'failed glyph');
    assert(blockHas($got, '--------------------'), 'half fill');
    assert(!blockHas($got, '---------------------'), 'not more than half');
    assert(blockHas($got, '50%'), 'percent');
    assert(blockHas($got, 'a.eco'), 'detail');
    assert(!blockHas($got, '100%'), 'not finished');
}

test progress_over_advance_clamps
{
    element::Progress $p = command::CLIContext::plain()->create<element::Progress>();
    $p->start('download', 4);
    $p->advance(100, '');
    $p->fail();

    $got = $p->line->ctx->page;
    assert(blockHas($got, '----------------------------------------'), 'full bar');
    assert(blockHas($got, '100%'), 'clamped');
}

test progress_start_is_silent_on_a_pipe
{
    element::Progress $p = command::CLIContext::plain()->create<element::Progress>();
    $p->start('download', 10);
    $p->set(3, 'x');

    assert($p->line->ctx->vt == '', 'no rewrite in a log');
    assert($p->line->ctx->page->rows->count() == 0, 'no rewrite in a log');
}

test progress_interactive_paints_then_commits
{
    command::TerminalCapabilities $caps = command::TerminalCapabilities(false, false, 80, true);
    element::Progress $p = command::CLIContext::buffer($caps)->create<element::Progress>();
    $p->start('download', 10);
    thread::sleep(200);
    $p->set(4, 'a.eco');
    $p->finish();

    string $got = $p->line->ctx->vt;
    assert($got->contains(command::CSI_ERASE_LINE), 'rewrote');
    assert($got->contains('*'), 'done glyph');
    assert($got->contains('100%'), 'final');
    assert($got->ends(keyCh(command::CH_LF)), 'newline');
}

test progress_colour_splits_fill_and_rest
{
    command::TerminalCapabilities $caps = command::TerminalCapabilities(true, false, 80, true);
    element::Progress $p = command::CLIContext::buffer($caps)->create<element::Progress>();
    $p->start('download', 10);
    $p->set(5, 'a.eco');
    $p->fail();

    string $got = $p->line->ctx->vt;
    assert($got->contains("\x1b[33m--------------------\x1b[39m"), 'yellow fill');
    assert($got->contains("\x1b[31m--------------------\x1b[39m"), 'red fill');
    assert($got->contains("\x1b[90m--------------------\x1b[39m"), 'grey rest');
}

test progress_large_total_does_not_wrap
{
    element::Progress $p = command::CLIContext::plain()->create<element::Progress>();
    $p->start('download', 100000000);
    $p->set(50000000, '');
    $p->fail();

    $got = $p->line->ctx->page;
    assert(blockHas($got, '50%'), 'half of a byte-count total');
    assert(!blockHas($got, '-%'), 'not a wrapped percent');
}

test progress_unicode_finish_uses_the_check
{
    command::TerminalCapabilities $caps = command::TerminalCapabilities(false, true, 80, false);
    element::Progress $p = command::CLIContext::buffer($caps)->create<element::Progress>();
    $p->start('download', 10);
    $p->finish();

    $got = $p->line->ctx->page;
    assert(blockHas($got, '✔'), 'check');
    assert(blockHas($got, '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'), 'full track');
    assert(blockHas($got, '100%'), 'full percent');
}
