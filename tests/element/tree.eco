/**
 * Tree connectors.
 */

use command::element;

test tree_ascii_nested
{
    element::Tree $t = command::CLIContext::plain()->create<element::Tree>('libcommand');
    element::Node $cli = element::Node('cli');
    $cli->children[] = element::Node('parse');
    $cli->children[] = element::Node('help');
    $t->root->children[] = $cli;
    $t->root->children[] = element::Node('widgets');

    $page = $t->render();

    assert(blockHas($page, 'libcommand'), 'root');
    assert(blockHas($page, '|- cli'), 'mid');
    assert(blockHas($page, '`- widgets'), 'last');
    assert(blockHas($page, '| |- parse'), 'nested');
    assert(blockHas($page, '| `- help'), 'nested last');
}

test tree_unicode_connectors
{
    command::CLIContext $ctx = .buffer(
        command::TerminalCapabilities(false, true, 80, true)
    );
    element::Tree $t = $ctx->create<element::Tree>('root');
    $t->root->children[] = element::Node('a');
    $t->root->children[] = element::Node('b');

    $page = $t->render();

    assert(blockHas($page, '├─ a'), 'mid');
    assert(blockHas($page, '└─ b'), 'last');
}

test tree_display_captures
{
    command::CLIContext $ctx = .plain();
    element::Tree $t = $ctx->create<element::Tree>('libcommand');
    $t->root->children[] = element::Node('cli');
    $t->display();

    $page = $t->render();
    assert($t->captured == $page, 'captured matches render');
    assert(blockHas($t->captured, 'libcommand'), 'root');
    assert(blockHas($t->captured, '`- cli'), 'child');
    assert($ctx->vt->empty(), 'buffer capture is on the widget');
    assert($ctx->page->rows->count() == 0, 'buffer capture is on the widget');

    $t->display();
    assert($t->captured->rows->count() == $page->rows->count() * 2, 'second display appends');
}
