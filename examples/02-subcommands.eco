// a table with a subcommand: accept, require, fallback, closed values, valueOn, repeat.
//
//   echoc run -m . examples/02-subcommands.eco -- build -o app src/main.eco
//   echoc run -m . examples/02-subcommands.eco -- build --help optimize
//   echoc run -m . examples/02-subcommands.eco -- build -o app --link curl --link ssl src/main.eco

use command;
use std::env;
use std::io;

command::Command $app = command::Command('greet', '0.1.0', 'say hello');
command::Subcommand $build = $app->command('build', 'compile a native executable', 'Compile your program and write a binary.');
$app->positional($build, '<sources...>', 'the .eco files to compile', 'Loose files become the main module.', 0, -1, 'What is built');

command::Arg $out = $app->arg('output', 'o', '<file>', 'where the executable is written');
$app->category($out, 'What is built');
$app->require($out, $build);
array<string> $outProse = [
    'The path of the binary.',
    '  greet build -o app src/*.eco',
];
$app->describe($out, $outProse);

command::Arg $opt = $app->arg('optimize', '', '<mode>', 'how hard, and over how much at once');
$app->category($opt, 'How it is built');
$app->accept($opt, $build);
$app->fallback($opt, 'module');
$modes = array<command::OptionValue>();
$modes[] = command::OptionValue('none', 'skip the pipeline', 'Emit IR as codegen wrote it.');
$modes[] = command::OptionValue('module', 'each unit on its own', 'The default, and the only mode the cache can help with.');
$modes[] = command::OptionValue('whole', 'merge every unit, then optimize', 'Inlining across modules. Bypasses the cache.');
$app->values($opt, $modes);
$app->valueOn($opt, 'whole', $build);
$app->describe($opt, 'How hard the optimizer works, and how much of your program it may look at once.');

command::Arg $link = $app->repeat('link', '', '<requirement>', 'add a link requirement');
$app->accept($link, $build);

$r = $app->parse(env::argv());

if ($r->error != null) {
    command::Error $e = $r->error ?? .noCommand;
    command::CLIContext $err = .from($r->parsed, $app, .stderr);
    $err->print(command::renderError($e, $app, $r->parsed, $err));
    env::exit(1);
}

$parsed = $r->parsed;

if ($parsed->wantsVersion) {
    io::println(command::renderVersion($app));
    env::exit(0);
}

if ($parsed->wantsHelp) {
    command::CLIContext $help = .from($parsed, $app, .stdout);
    $help->print(command::renderHelp($app, $parsed, $help));
    env::exit(0);
}

$links = str::join($parsed->values($link), ', ');
echo "command: {$parsed->subject($app)}";
echo "output: {$parsed->value($out)}";
echo "optimize: {$parsed->value($opt)}";
echo "link: {$links}";

usize $i = 0;

while ($i < $parsed->positionals->count()) {
    echo "source: {$parsed->positionals[$i]}";
    $i = $i + 1;
}
