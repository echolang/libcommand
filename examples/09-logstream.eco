// a docker-build style window: last few rows of a stream, a spinner
// docked above it, then a bar docked below it, then a build that breaks
//
//   echoc run -m . examples/09-logstream.eco
//   echoc run -m . examples/09-logstream.eco 2>&1 | cat

use command;
use command::element;
use std::thread;

command::CLIContext $ctx = .resolve(.auto, .stderr);
$ctx->beginStepper('logstream');

array<string> $install = [
    'Step 1/4 : FROM alpine:3.20',
    ' ---> 9a1f3c2e4b5d',
    'Step 2/4 : RUN apk add --no-cache build-base',
    'fetch https://dl-cdn.alpinelinux.org/alpine/v3.20/main/aarch64/APKINDEX.tar.gz',
    '(1/12) Installing libgcc (13.2.1_git20240309-r0)',
    '(2/12) Installing libstdc++ (13.2.1_git20240309-r0)',
    '(3/12) Installing binutils (2.42-r0)',
    '(4/12) Installing gmp (6.3.0-r1)',
    '(5/12) Installing gcc (13.2.1_git20240309-r0)',
    '(6/12) Installing musl-dev (1.2.5-r0)',
    'OK: 212 MiB in 26 packages',
];

$image = $ctx->create<element::LogStream>(5);
$spin = $image->spinner();
$spin->start('building image');

foreach ($install as $i => $row) {
    thread::sleep(180);
    $image->push($row);

    if ($i == 1) {
        $image->print('cached  FROM alpine:3.20');
    }
}

$spin->succeed('built image app:latest');

array<string> $files = ['tensor', 'layer', 'model', 'loss', 'optimizer', 'trainer', 'codec', 'dataset'];
$compile = $ctx->create<element::LogStream>(4);
$bar = $compile->progress();
$bar->start('compile', 8);

foreach ($files as $f) {
    $compile->push("cc -O2 -c src/{$f}.c -o build/{$f}.o");
    thread::sleep(120);
    $compile->push("  note: {$f}.c: 0 warnings");
    thread::sleep(120);
    $bar->advance(1, "{$f}.o");
}

$bar->finish();

$link = $ctx->create<element::LogStream>(4);
$step = $link->progress();
$step->start('link', 3);
$link->push('ld -o app build/*.o');
thread::sleep(250);
$step->advance(1, 'app');
$link->push('ld: error: undefined symbol: ann_tensor_free');
$link->push('>>> referenced by model.o');
thread::sleep(250);
$step->fail();

$ctx->endStepper('1 step failed');
